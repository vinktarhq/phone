{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vinktar-ai": {
      "type": "streamable-http",
      "url": "https://mcp.vinktar.ai/mcp?login",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "calls:read",
              "calls:place"
            ]
          }
        }
      }
    }
  }
}
